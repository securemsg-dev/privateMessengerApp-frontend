{
  "cli": { "version": ">= 12.0.0" },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://privatemessengerapp-backend-production.up.railway.app/api/v1"
      }
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://privatemessengerapp-backend-production.up.railway.app/api/v1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
