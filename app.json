{
  "expo": {
    "name": "PrivaChat",
    "slug": "privachat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.securemsg.app",
      "infoPlist": {
        "NSCameraUsageDescription": "PrivaChat needs camera access to send photos and videos.",
        "NSMicrophoneUsageDescription": "PrivaChat needs microphone access to send voice messages and make calls.",
        "NSPhotoLibraryUsageDescription": "PrivaChat needs photo library access to send images and videos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.securemsg.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PrivaChat to access your photos.",
          "cameraPermission": "Allow PrivaChat to access your camera."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow PrivaChat to access your microphone for voice messages."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "e33c1a12-10ed-4e3f-aae8-898608927649"
      }
    },
    "owner": "securemsg-dev"
  }
}
